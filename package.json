{
  "name": "santic-fichas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node scripts/build.mjs",
    "build:e2e": "NEXT_PUBLIC_BASE_PATH=/fichas NEXT_PUBLIC_ADS_PLACEHOLDER=true NEXT_PUBLIC_ADS_ANCHOR=true node scripts/build.mjs",
    "serve:out": "node scripts/serve-out.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "budget": "node scripts/budget.mjs",
    "metrics:fonts": "node scripts/gen-sheet-font-metrics.mjs"
  },
  "dependencies": {
    "@fontsource/andika": "5.3.0",
    "@fontsource/archivo": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "next": "16.3.5",
    "pdf-lib": "1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "pdfjs-dist": "6.3.289",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
